; Engine configuration file.
config_version=5

[application]
config/name="Cursed Pawn"
run/main_scene="res://game/ui/shop_game.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]
Flags="*res://game/autoload/flags.gd"
Controls="*res://game/autoload/controls.gd"

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[debug]
gdscript/warnings/untyped_declaration=1
gdscript/warnings/inferred_declaration=0

[physics]
common/physics_ticks_per_second=60

[rendering]
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.0431, 0.0275, 0.0627, 1)
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
